# Copy this file to ".env" in the project root (D:\Assignment\.env)
# NEVER commit .env — it is in .gitignore

# --- Local Docker Compose only (db runs in container "db") ---
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory_db
DATABASE_URL=postgresql://inventory:inventory@db:5432/inventory_db

# --- Local dev pointing at Render Postgres (optional) ---
# Use the "External Database URL" from Render dashboard, or build:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# --- Frontend (local npm run dev) ---
VITE_API_URL=http://localhost:5000

# --- Production: set these in Render / Vercel dashboards, NOT in a file you push to GitHub ---
# Render Web Service → Environment → DATABASE_URL = Internal Database URL from Render
# Vercel → Environment → VITE_API_URL = https://your-backend.onrender.com
